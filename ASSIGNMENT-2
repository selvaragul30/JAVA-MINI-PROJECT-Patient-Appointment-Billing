import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

public class HospitalManagementSystem {
    private static final Scanner sc = new Scanner(System.in);

    private static final List<Patient> patients = new ArrayList<>();
    private static final List<Doctor> doctors = new ArrayList<>();
    private static final List<Appointment> appointments = new ArrayList<>();
    private static final List<Consultation> consultations = new ArrayList<>();
    private static final List<Invoice> invoices = new ArrayList<>();
    private static final List<Payment> payments = new ArrayList<>();

    private static int patientCounter = 1;
    private static int doctorCounter = 1;
    private static int appointmentCounter = 1;
    private static int consultationCounter = 1;
    private static int invoiceCounter = 1;
    private static int paymentCounter = 1;

    private static String readText(String message) {
        while (true) {
            System.out.print(message);
            String value = sc.nextLine().trim();

            if (!value.isEmpty()) {
                return value;
            }

            System.out.println("Input cannot be empty.");
        }
    }

    private static int readInt(String message) {
        while (true) {
            try {
                System.out.print(message);
                return Integer.parseInt(sc.nextLine().trim());
            } catch (NumberFormatException e) {
                System.out.println("Enter a valid integer.");
            }
        }
    }

    private static double readAmount(String message) {
        while (true) {
            try {
                System.out.print(message);
                double value = Double.parseDouble(sc.nextLine().trim());

                if (Double.isFinite(value) && value >= 0) {
                    return value;
                }
            } catch (NumberFormatException e) {
                // Invalid amount; prompt again.
            }

            System.out.println("Enter a valid non-negative amount.");
        }
    }

    private static Patient findPatient(int id) {
        for (Patient p : patients) {
            if (p.getId() == id) return p;
        }
        return null;
    }

    private static Doctor findDoctor(int id) {
        for (Doctor d : doctors) {
            if (d.getId() == id) return d;
        }
        return null;
    }

    private static Appointment findAppointment(int id) {
        for (Appointment a : appointments) {
            if (a.getId() == id) return a;
        }
        return null;
    }

    private static Consultation findConsultation(int id) {
        for (Consultation c : consultations) {
            if (c.getId() == id) return c;
        }
        return null;
    }

    private static Invoice findInvoice(int id) {
        for (Invoice i : invoices) {
            if (i.getId() == id) return i;
        }
        return null;
    }

    private static void addPatient() {
        String name = readText("Patient name: ");

        int age;
        do {
            age = readInt("Age: ");
            if (age < 0 || age > 130) {
                System.out.println("Enter age from 0 to 130.");
            }
        } while (age < 0 || age > 130);

        String phone = readText("Phone: ");

        Patient p = new Patient(patientCounter++, name, age, phone);
        patients.add(p);

        System.out.println("Patient added successfully. ID: " + p.getId());
    }

    private static void addDoctor() {
        String name = readText("Doctor name: ");
        String specialization = readText("Specialization: ");
        double fee = readAmount("Consultation fee: ");

        Doctor d = new Doctor(doctorCounter++, name, specialization, fee);
        doctors.add(d);

        System.out.println("Doctor added successfully. ID: " + d.getId());
    }

    private static void scheduleAppointment() {
        if (patients.isEmpty() || doctors.isEmpty()) {
            System.out.println("Add a patient and doctor first.");
            return;
        }

        System.out.println("\n--- Patients ---");
        for (Patient p : patients) {
            System.out.println(p);
        }

        Patient patient = findPatient(readInt("Patient ID: "));
        if (patient == null) {
            System.out.println("Patient not found.");
            return;
        }

        System.out.println("\n--- Doctors ---");
        for (Doctor d : doctors) {
            System.out.println(d);
        }

        Doctor doctor = findDoctor(readInt("Doctor ID: "));
        if (doctor == null) {
            System.out.println("Doctor not found.");
            return;
        }

        LocalDateTime dateTime;
        try {
            System.out.print("Date and time (yyyy-MM-dd HH:mm): ");
            dateTime = LocalDateTime.parse(
                    sc.nextLine().trim(),
                    DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm"));
        } catch (Exception e) {
            System.out.println("Invalid date/time format.");
            return;
        }

        if (!dateTime.isAfter(LocalDateTime.now())) {
            System.out.println("Appointment must be in the future.");
            return;
        }

        // Prevent overlapping 30-minute slots for the same doctor.
        LocalDateTime endTime = dateTime.plusMinutes(30);

        for (Appointment existing : appointments) {
            LocalDateTime existingEnd =
                    existing.getDateTime().plusMinutes(30);

            boolean overlaps =
                    dateTime.isBefore(existingEnd)
                    && existing.getDateTime().isBefore(endTime);

            if (existing.getDoctor().getId() == doctor.getId()
                    && overlaps) {
                System.out.println("Doctor's slot is unavailable.");
                return;
            }
        }

        Appointment a = new Appointment(
                appointmentCounter++, patient, doctor, dateTime);

        appointments.add(a);
        System.out.println("\nAppointment confirmed!");
        a.display();
    }

    private static void recordConsultation() {
        System.out.println("\n--- Appointments ---");
        for (Appointment a : appointments) {
            a.display();
        }

        Appointment appointment =
                findAppointment(readInt("Appointment ID: "));

        if (appointment == null) {
            System.out.println("Appointment not found.");
            return;
        }

        if (appointment.isCompleted()) {
            System.out.println("Consultation already recorded.");
            return;
        }

        if (appointment.getDateTime().isAfter(LocalDateTime.now())) {
            System.out.println("Cannot record consultation before "
                    + "the appointment time.");
            return;
        }

        String diagnosis = readText("Diagnosis: ");

        Consultation consultation = new Consultation(
                consultationCounter++, appointment, diagnosis);

        while (true) {
            String answer = readText("Add prescription? (yes/no): ");

            if (answer.equalsIgnoreCase("no")) {
                break;
            }

            if (!answer.equalsIgnoreCase("yes")) {
                System.out.println("Enter yes or no.");
                continue;
            }

            String item = readText("Prescription item: ");

            int quantity;
            do {
                quantity = readInt("Quantity: ");
                if (quantity <= 0) {
                    System.out.println("Quantity must be positive.");
                }
            } while (quantity <= 0);

            double price = readAmount("Unit price: ");

            consultation.addPrescription(
                    new Prescription(item, quantity, price));
        }

        appointment.setCompleted(true);
        consultations.add(consultation);
        consultation.display();
    }

    private static void generateInvoice() {
        if (consultations.isEmpty()) {
            System.out.println("No consultations available.");
            return;
        }

        for (Consultation c : consultations) {
            System.out.println("Consultation ID: " + c.getId()
                    + " | Patient: "
                    + c.getAppointment().getPatient().getName());
        }

        Consultation consultation =
                findConsultation(readInt("Consultation ID: "));

        if (consultation == null) {
            System.out.println("Consultation not found.");
            return;
        }

        for (Invoice existing : invoices) {
            if (existing.getConsultation().getId()
                    == consultation.getId()) {
                System.out.println("Invoice already exists.");
                existing.display();
                return;
            }
        }

        Invoice invoice = new Invoice(invoiceCounter++, consultation);
        invoices.add(invoice);
        invoice.display();
    }

    private static void recordPayment() {
        if (invoices.isEmpty()) {
            System.out.println("No invoices available.");
            return;
        }

        for (Invoice invoice : invoices) {
            invoice.display();
        }

        Invoice invoice = findInvoice(readInt("Invoice ID: "));

        if (invoice == null) {
            System.out.println("Invoice not found.");
            return;
        }

        if (invoice.isClosed()) {
            System.out.println("Invoice is already closed.");
            return;
        }

        double due = invoice.getOutstanding();
        System.out.printf("Outstanding: Rs. %.2f%n", due);

        double amount;
        do {
            amount = readAmount("Payment amount: ");

            if (amount <= 0 || amount > invoice.getOutstanding()) {
                System.out.println("Payment must be greater than zero "
                        + "and cannot exceed the outstanding balance.");
            }
        } while (amount <= 0 || amount > invoice.getOutstanding());

        String method = readText("Payment method (Cash/Card/UPI): ");

        try {
            Payment payment = new Payment(
                    paymentCounter++, invoice, amount, method);

            payments.add(payment);
            payment.printReceipt();
        } catch (IllegalArgumentException
                 | IllegalStateException e) {
            System.out.println("Payment failed: " + e.getMessage());
        }
    }

    private static void listAppointments() {
        System.out.println("\n--- APPOINTMENT LIST ---");

        if (appointments.isEmpty()) {
            System.out.println("No appointments found.");
            return;
        }

        for (Appointment a : appointments) {
            a.display();
        }
    }

    private static void outstandingDuesReport() {
        double totalDue = 0;

        System.out.println("\n--- OUTSTANDING DUES REPORT ---");

        for (Invoice invoice : invoices) {
            if (!invoice.isClosed() && invoice.getOutstanding() > 0) {
                System.out.printf(
                        "Invoice ID: %d | Patient: %s | Due: Rs. %.2f%n",
                        invoice.getId(),
                        invoice.getConsultation().getAppointment()
                                .getPatient().getName(),
                        invoice.getOutstanding());

                totalDue += invoice.getOutstanding();
            }
        }

        System.out.printf("Total outstanding dues: Rs. %.2f%n", totalDue);
    }

    public static void main(String[] args) {
        while (true) {
            System.out.println("\n===== PATIENT APPOINTMENT & BILLING =====");
            System.out.println("1. Add Patient");
            System.out.println("2. Add Doctor");
            System.out.println("3. Schedule Appointment");
            System.out.println("4. Record Consultation");
            System.out.println("5. Generate Invoice");
            System.out.println("6. Record Payment");
            System.out.println("7. List Appointments");
            System.out.println("8. Outstanding Dues Report");
            System.out.println("9. Exit");

            int choice = readInt("Enter choice: ");
            switch (choice) {
                
                case 1:
                    addPatient();
                    break;
                case 2:
                    addDoctor();
                    break;
                case 3:
                    scheduleAppointment();
                    break;
                case 4:
                    recordConsultation();
                    break;
                case 5:
                    generateInvoice();
                    break;
                case 6:
                    recordPayment();
                    break;
                case 7:
                    listAppointments();
                    break;
                case 8:
                    outstandingDuesReport();
                    break;
                case 9:
                    System.out.println("Exiting application. Goodbye!");
                    sc.close();
                    return;
                default:
                    System.out.println("Invalid choice. Try again.");
            }
        }
    }
}
