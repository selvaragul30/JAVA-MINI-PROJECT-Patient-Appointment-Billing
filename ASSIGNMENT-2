import java.util.ArrayList;
import java.util.List;

public class Consultation {
    private int id;
    private Appointment appointment;
    private String diagnosis;
    private List<Prescription> prescriptions;

    public Consultation(int id, Appointment appointment,
                        String diagnosis) {
        this.id = id;
        this.appointment = appointment;
        this.diagnosis = diagnosis;
        this.prescriptions = new ArrayList<>();
    }

    public int getId() {
        return id;
    }

    public Appointment getAppointment() {
        return appointment;
    }

    public String getDiagnosis() {
        return diagnosis;
    }

    public List<Prescription> getPrescriptions() {
        return prescriptions;
    }

    public void addPrescription(Prescription prescription) {
        prescriptions.add(prescription);
    }

    public double getPrescriptionTotal() {
        double total = 0;

        for (Prescription p : prescriptions) {
            total += p.getTotal();
        }

        return total;
    }

    public void display() {
        System.out.println("\n--- CONSULTATION SUMMARY ---");
        System.out.println("Consultation ID: " + id);
        System.out.println("Patient: "
                + appointment.getPatient().getName());
        System.out.println("Doctor: Dr. "
                + appointment.getDoctor().getName());
        System.out.println("Diagnosis: " + diagnosis);
        System.out.println("Prescriptions:");

        if (prescriptions.isEmpty()) {
            System.out.println("No prescriptions.");
        }

        for (Prescription p : prescriptions) {
            System.out.println(p);
        }
    }
}

Invoice.java
public class Invoice {
    private int id;
    private Consultation consultation;
    private double consultationFee;
    private double prescriptionTotal;
    private double tax;
    private double total;
    private double amountPaid;
    private boolean closed;

    public Invoice(int id, Consultation consultation) {
        this.id = id;
        this.consultation = consultation;

        this.consultationFee = consultation.getAppointment()
                .getDoctor().getConsultationFee();

        this.prescriptionTotal = consultation.getPrescriptionTotal();

        // Example tax rate: 5%
        this.tax = (consultationFee + prescriptionTotal) * 0.05;

        this.total = consultationFee + prescriptionTotal + tax;
        this.amountPaid = 0;
        this.closed = false;
    }

    public int getId() {
        return id;
    }

    public Consultation getConsultation() {
        return consultation;
    }

    public double getTotal() {
        return total;
    }

    public double getAmountPaid() {
        return amountPaid;
    }

    public boolean isClosed() {
        return closed;
    }

    public double getOutstanding() {
        return Math.max(0, total - amountPaid);
    }

    public void addPayment(double amount) {
        if (closed) {
            throw new IllegalStateException("Invoice is already closed.");
        }

        if (amount <= 0 || amount > getOutstanding()) {
            throw new IllegalArgumentException(
                    "Payment must be positive and cannot exceed the due.");
        }

        amountPaid += amount;

        if (getOutstanding() < 0.005) {
            amountPaid = total;
            closed = true;
        }
    }

    public void display() {
        System.out.println("\n========== INVOICE ==========");
        System.out.println("Invoice ID: " + id);
        System.out.println("Patient: "
                + consultation.getAppointment()
                .getPatient().getName());

        System.out.printf("Consultation Fee: Rs. %.2f%n",
                consultationFee);
        System.out.printf("Prescription Total: Rs. %.2f%n",
                prescriptionTotal);
        System.out.printf("Tax (5%%): Rs. %.2f%n", tax);
        System.out.printf("Total: Rs. %.2f%n", total);
        System.out.printf("Paid: Rs. %.2f%n", amountPaid);
        System.out.printf("Outstanding: Rs. %.2f%n",
                getOutstanding());

        System.out.println("Status: " + (closed ? "CLOSED" : "OPEN"));
        System.out.println("=============================");
    }
}

