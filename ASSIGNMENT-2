import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

public class Payment {
    private int id;
    private Invoice invoice;
    private double amount;
    private String method;
    private LocalDateTime paymentTime;

    public Payment(int id, Invoice invoice,
                   double amount, String method) {
        if (invoice == null) {
            throw new IllegalArgumentException("Invoice is required.");
        }

        invoice.addPayment(amount);

        this.id = id;
        this.invoice = invoice;
        this.amount = amount;
        this.method = method;
        this.paymentTime = LocalDateTime.now();
    }

    public int getId() {
        return id;
    }

    public Invoice getInvoice() {
        return invoice;
    }

    public double getAmount() {
        return amount;
    }

    public String getMethod() {
        return method;
    }

    public void printReceipt() {
        DateTimeFormatter formatter =
                DateTimeFormatter.ofPattern("dd-MM-yyyy HH:mm:ss");

        System.out.println("\n======= PAYMENT RECEIPT =======");
        System.out.println("Payment ID: " + id);
        System.out.println("Invoice ID: " + invoice.getId());
        System.out.println("Patient: "
                + invoice.getConsultation().getAppointment()
                .getPatient().getName());

        System.out.printf("Amount Paid: Rs. %.2f%n", amount);
        System.out.println("Payment Method: " + method);
        System.out.println("Date: " + paymentTime.format(formatter));
        System.out.println("Invoice Status: "
                + (invoice.isClosed() ? "CLOSED" : "OPEN"));
        System.out.printf("Remaining Due: Rs. %.2f%n",
                invoice.getOutstanding());
        System.out.println("===============================");
    }
}

